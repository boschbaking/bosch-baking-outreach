NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for AI research + email drafting.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Email sending (Resend). RESEND_FROM_EMAIL must be on a domain you've
# verified in Resend (SPF/DKIM) — Resend won't deliver cold outreach from
# onboarding@resend.dev to real third-party recipients.
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@boschbaking.com
RESEND_FROM_NAME=Bosch Baking

# CAN-SPAM requires a physical mailing address in every commercial email.
BUSINESS_MAILING_ADDRESS="Bosch Baking, 123 Main St, Rancho Cucamonga, CA 91730"

# Used to build links (unsubscribe, etc.) in outbound emails — your live
# Netlify URL or custom domain, no trailing slash.
SITE_URL=https://bosch-baking-outreach.netlify.app

# Optional — defaults shown. Timezone the sending window (9am-4pm etc.) is
# evaluated in, and the secret used to sign unsubscribe links.
SENDING_TIMEZONE=America/Los_Angeles
UNSUBSCRIBE_SECRET=
